# Copy this file to config/.env or .env and fill in your values. NEVER commit the real .env.
#
# Telegram: create a bot with @BotFather to get the token, then message the bot once
# and fetch your chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Account capital used by the risk manager (paper-mode accounting, Phase B/C).
CAPITAL=100000

# Optional: DEBUG / INFO / WARNING (default INFO)
LOG_LEVEL=INFO

# Optional: pin the option-chain API endpoint (tried FIRST, before the built-in
# variants). Paste the exact request URL from Chrome DevTools -> Network tab:
# NSE_CHAIN_ENDPOINT=https://www.nseindia.com/api/option-chain-indices?symbol=NIFTY

# ==============================================================================
# Angel One SmartAPI (FREE Development / Local Tunnel Setup)
# ==============================================================================
# API key from SmartAPI developer dashboard (MyApps)
SMARTAPI_API_KEY=
# Angel One Client ID / Code (e.g. A123456)
SMARTAPI_CLIENT_CODE=
# Redirect URL configured in SmartAPI developer dashboard (Must be HTTPS)
# Example: https://<your-cloudflared-tunnel-host>/smartapi/callback
SMARTAPI_REDIRECT_URL=
# Dedicated local callback service host & port (Runs locally on 127.0.0.1)
SMARTAPI_CALLBACK_HOST=127.0.0.1
SMARTAPI_CALLBACK_PORT=8000

# ==============================================================================
# Execution Mode Authority (MUST REMAIN PAPER)
# ==============================================================================
# Default: PAPER. Live execution is strictly disabled.
EXECUTION_MODE=PAPER
